{
  "name": "mcp-claw",
  "version": "0.1.52",
  "private": false,
  "main": "dist/bundle.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-claw": "./dist/bundle.js",
    "sga": "./dist/bundle.js"
  },
  "scripts": {
    "bundle": "ncc build dist/cli.js -o dist/ncc --minify && node -e \"require('node:fs').copyFileSync('dist/ncc/index.js','dist/bundle.js')\"",
    "build": "tsc -p tsconfig.build.json && pnpm bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "files": [
    "dist/bundle.js",
    "dist/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@sga/core": "workspace:*",
    "@sga/shared": "workspace:*",
    "@types/archiver": "^6.0.3",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "archiver": "^7.0.1",
    "execa": "^9.6.0",
    "js-yaml": "^4.1.1",
    "ora": "^8.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.58.2",
    "zod": "^3.23.8",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.46",
    "@types/pdf-parse": "^1.1.5",
    "@vercel/ncc": "^0.38.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
