{
  "name": "mcp-claw",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "prepare": "husky install",
    "lint": "eslint . --ext .vue,.js,.ts,.cjs,.mjs --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,css,md,json}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "contract:lint": "spectral lint packages/shared/api-contract.yaml",
    "test:core": "pnpm --filter @mcp-claw/core test",
    "test:cli": "pnpm --filter @mcp-claw/cli test"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.15.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "vue-eslint-parser": "^9.4.3"
  }
}
